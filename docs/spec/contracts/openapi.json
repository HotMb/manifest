            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "post": {
        "operationId": "uploadAsset",
        "summary": "Uploader une image contrôlée, sans URL externe arbitraire",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Succès ; garanties métier dans CONTRACTS.md.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "mimeType": {
                      "type": "string"
                    },
                    "sizeBytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "assetId",
                    "sha256",
                    "mimeType",
                    "sizeBytes"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "licenseRef": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "file",
                  "alt",
                  "licenseRef"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
