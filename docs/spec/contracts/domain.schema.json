{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/design/v1/domain.schema.json",
  "title": "Design editor domain — documentation contract v1",
  "description": "Structural contract only. Registry validation, permissions, locks, limits and concurrency invariants in CONTRACTS.md are mandatory.",
  "$ref": "#/$defs/Snapshot",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "JsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 200
        }
      ]
    },
    "JsonObject": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "prototype",
            "constructor"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "maxProperties": 200
    },
    "Block": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "props": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "id"
          ],
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 100
        }
      },
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "Composition": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          },
          "minItems": 0,
          "maxItems": 500
        },
        "root": {
          "type": "object",
          "properties": {
            "props": {
              "$ref": "#/$defs/JsonObject"
            }
          },
          "required": [
            "props"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "content",
        "root"
      ],
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "route": {
          "type": "string",
          "pattern": "^/(?!/)[^?#\\s]*$",
          "maxLength": 300
        },
        "composition": {
          "$ref": "#/$defs/Composition"
        }
      },
      "required": [
        "id",
        "title",
        "route",
        "composition"
      ],
      "additionalProperties": false
    },
    "ThemeToken": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "color",
            "length",
            "font",
            "number",
            "duration"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "Theme": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 300,
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
              },
              {
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/ThemeToken"
          }
        }
      },
      "required": [
        "tokens"
      ],
      "additionalProperties": false
    },
    "CatalogLock": {
      "type": "object",
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target": {
          "const": "react"
        }
      },
      "required": [
        "releaseId",
        "sha256",
        "target"
      ],
      "additionalProperties": false
    },
    "DesignPolicy": {
      "type": "object",
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "releaseId",
        "sha256"
      ],
      "additionalProperties": false
    },
    "AssetRef": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "licenseRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "assetId",
        "sha256",
        "licenseRef"
      ],
      "additionalProperties": false
    },
    "Lock": {
      "type": "object",
      "properties": {
        "pageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "blockId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "pageId",
        "blockId",
        "properties"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "projectTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Page"
          },
          "minItems": 1,
          "maxItems": 10
        },
        "theme": {
          "$ref": "#/$defs/Theme"
        },
        "assetRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "catalogLock": {
          "$ref": "#/$defs/CatalogLock"
        },
        "designPolicy": {
          "$ref": "#/$defs/DesignPolicy"
        },
        "locks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Lock"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "designBrief": {
          "$ref": "#/$defs/DesignBrief"
        }
      },
      "required": [
        "schemaVersion",
        "projectTitle",
        "pages",
        "theme",
        "assetRefs",
        "catalogLock",
        "designPolicy",
        "locks",
        "designBrief"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "insert_block"
            },
            "pageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "parentBlockId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "slot": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "beforeBlockId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "block": {
              "$ref": "#/$defs/Block"
            }
          },
          "required": [
            "op",
            "pageId",
            "parentBlockId",
            "slot",
            "beforeBlockId",
            "block"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "update_props"
            },
            "pageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "blockId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "props": {
              "$ref": "#/$defs/JsonObject",
              "minProperties": 1
            }
          },
          "required": [
            "op",
            "pageId",
            "blockId",
            "props"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "move_block"
            },
            "pageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "blockId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "parentBlockId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "slot": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "beforeBlockId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op",
            "pageId",
            "blockId",
            "parentBlockId",
            "slot",
            "beforeBlockId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove_block"
            },
            "pageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "blockId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "op",
            "pageId",
            "blockId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "update_theme"
            },
            "tokens": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 300,
              "additionalProperties": {
                "$ref": "#/$defs/ThemeToken"
              },
              "propertyNames": {
                "allOf": [
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
                  },
                  {
                    "not": {
                      "enum": [
                        "__proto__",
                        "prototype",
                        "constructor"
                      ]
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "op",
            "tokens"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "add_page"
            },
            "page": {
              "$ref": "#/$defs/Page"
            }
          },
          "required": [
            "op",
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "update_page"
            },
            "pageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "route": {
              "type": "string",
              "pattern": "^/(?!/)[^?#\\s]*$",
              "maxLength": 300
            }
          },
          "required": [
            "op",
            "pageId",
            "title",
            "route"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "remove_page"
            },
            "pageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "op",
            "pageId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "update_brief"
            },
            "brief": {
              "$ref": "#/$defs/DesignBrief"
            }
          },
          "required": [
            "op",
            "brief"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "set_locks"
            },
            "locks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Lock"
              },
              "maxItems": 200
            }
          },
          "required": [
            "op",
            "locks"
          ],
          "additionalProperties": false
        }
      ]
    },
    "OperationList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "Command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "expectedDraftVersion": {
              "type": "integer",
              "minimum": 0
            },
            "idempotencyKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "action": {
              "const": "apply_ops"
            },
            "payload": {
              "type": "object",
              "properties": {
                "operations": {
                  "$ref": "#/$defs/OperationList"
                }
              },
              "required": [
                "operations"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "projectId",
            "expectedDraftVersion",
            "idempotencyKey",
            "action",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "expectedDraftVersion": {
              "type": "integer",
              "minimum": 0
            },
            "idempotencyKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "action": {
              "const": "keep_proposal"
            },
            "payload": {
              "type": "object",
              "properties": {
                "proposalId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "operationsAfter": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Operation"
                  },
                  "minItems": 0,
                  "maxItems": 100
                }
              },
              "required": [
                "proposalId",
                "operationsAfter"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "projectId",
            "expectedDraftVersion",
            "idempotencyKey",
            "action",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "expectedDraftVersion": {
              "type": "integer",
              "minimum": 0
            },
            "idempotencyKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "action": {
              "const": "approve"
            },
            "payload": {
              "type": "object",
              "properties": {
                "proposalId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "proposalId"
              ],
              "additionalProperties": false
            },
            "expectedHeadRevisionId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "projectId",
            "expectedDraftVersion",
            "idempotencyKey",
            "action",
            "payload",
            "expectedHeadRevisionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "expectedDraftVersion": {
              "type": "integer",
              "minimum": 0
            },
            "idempotencyKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "action": {
              "const": "restore"
            },
            "payload": {
              "type": "object",
              "properties": {
                "revisionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "required": [
                "revisionId"
              ],
              "additionalProperties": false
            },
            "expectedHeadRevisionId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "projectId",
            "expectedDraftVersion",
            "idempotencyKey",
            "action",
            "payload",
            "expectedHeadRevisionId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SuggestionRequest": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expectedDraftVersion": {
          "type": "integer",
          "minimum": 0
        },
        "editorSessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "intentEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic",
            "google",
            "deepseek",
            "custom"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "enum": [
            "auto",
            "direct",
            "alternatives"
          ]
        },
        "selectedPageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "selectedBlockId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "idempotencyKey",
        "expectedDraftVersion",
        "editorSessionId",
        "intentEpoch",
        "intent",
        "provider",
        "model",
        "mode",
        "selectedPageId",
        "selectedBlockId"
      ],
      "additionalProperties": false
    },
    "ExportRequest": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "target": {
          "const": "react"
        }
      },
      "required": [
        "idempotencyKey",
        "revisionId",
        "target"
      ],
      "additionalProperties": false
    },
    "Proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "generationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "editorSessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "intentEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "baseDraftVersion": {
          "type": "integer",
